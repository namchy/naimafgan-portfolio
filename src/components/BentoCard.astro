---
interface Props {
  title?: string;
  class?: string; // Ovdje ćemo ubacivati col-span-2, row-span-2 itd.
  href?: string;
}

const { title, class: className, href } = Astro.props;

// Definišemo osnovni izgled kartice: Tamna, zaobljena, sa bordurom
const baseStyles = "rounded-2xl bg-slate-800 border border-slate-700 p-6 flex flex-col transition-all hover:border-slate-500 hover:shadow-lg group";
---

{
  href ? (
    <a href={href} class={`${baseStyles} ${className} cursor-pointer hover:-translate-y-1`}>
      {title && <h3 class="text-lg font-bold text-slate-200 mb-2 group-hover:text-white">{title}</h3>}
      <div class="flex-1 flex flex-col">
        <slot />
      </div>
    </a>
  ) : (
    <div class={`${baseStyles} ${className}`}>
      {title && <h3 class="text-lg font-bold text-slate-200 mb-2">{title}</h3>}
      <div class="flex-1 flex flex-col">
        <slot />
      </div>
    </div>
  )
}