---
// src/components/BentoCard.astro
interface Props {
  title?: string;
  subTitle?: string;
  class?: string;
  href?: string;
}

const { title, subTitle, class: className, href } = Astro.props;

const baseStyles = "bg-neutral-900 border border-white/10 rounded-2xl p-8 flex flex-col transition-colors hover:border-orange-500/50 group relative overflow-hidden";
---

{
  href ? (
    <a href={href} class={`${baseStyles} ${className} cursor-pointer`}>
      <div class="absolute top-0 right-0 w-32 h-32 bg-orange-500/0 group-hover:bg-orange-500/10 rounded-full blur-3xl -mr-10 -mt-10 transition-colors"></div>
      
      {title && <h3 class="text-2xl font-bold text-white mb-2 relative z-10">{title}</h3>}
      {subTitle && <p class="text-neutral-500 text-sm mb-4 relative z-10">{subTitle}</p>}
      
      <div class="flex-1 flex flex-col relative z-10">
        <slot />
      </div>
    </a>
  ) : (
    <div class={`${baseStyles} ${className}`}>
      <div class="absolute top-0 right-0 w-32 h-32 bg-orange-500/0 group-hover:bg-orange-500/10 rounded-full blur-3xl -mr-10 -mt-10 transition-colors"></div>

      {title && <h3 class="text-2xl font-bold text-white mb-4 relative z-10">{title}</h3>}
      {subTitle && <p class="text-neutral-500 text-sm mb-4 relative z-10">{subTitle}</p>}
      
      <div class="flex-1 flex flex-col relative z-10">
        <slot />
      </div>
    </div>
  )
}