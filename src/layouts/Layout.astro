---
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Senior AI Strategy & Transformation Partner with 20+ years of experience leading complex projects in Pharma, Fintech, and Telecom." 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    {/* Open Graph / Social Media Meta Tags */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/hero-desktop.jpg" /> {/* Default share image */}

    <title>{title}</title>

    {/* Fonts (Optional: Inter from Google Fonts) */}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  </head>
  
  <body class="bg-black text-white font-sans antialiased selection:bg-orange-500 selection:text-white">
    
    {/* GLOBAL NAVIGATION BUTTON (Fixed Top Right) */}
    <button id="menu-toggle" class="fixed top-6 right-6 z-50 group flex flex-col items-end gap-1.5 focus:outline-none cursor-pointer mix-blend-difference">
      <span id="line1" class="block h-[2px] w-8 bg-white transition-all duration-300"></span>
      <span id="line2" class="block h-[2px] w-6 bg-white transition-all duration-300 group-hover:w-8"></span>
      <span id="line3" class="block h-[2px] w-8 bg-white transition-all duration-300"></span>
    </button>

    {/* FULL SCREEN MENU OVERLAY */}
    <div id="menu-overlay" class="fixed inset-0 bg-neutral-950/95 backdrop-blur-md z-40 transform translate-x-full transition-transform duration-500 ease-in-out flex items-center justify-center">
      <nav class="flex flex-col items-center gap-8 text-center">
        <a href="/" class="menu-link text-4xl md:text-6xl font-bold text-neutral-400 hover:text-white hover:scale-105 transition-all duration-300">Home</a>
        <a href="/experience" class="menu-link text-4xl md:text-6xl font-bold text-neutral-400 hover:text-white hover:scale-105 transition-all duration-300">Experience</a>
        <a href="/about" class="menu-link text-4xl md:text-6xl font-bold text-neutral-400 hover:text-white hover:scale-105 transition-all duration-300">About</a>
        
        {/* CONTACT LINK TO LINKEDIN */}
        <a 
          href="https://www.linkedin.com/in/naimafgan/" 
          target="_blank"
          rel="noopener noreferrer"
          class="menu-link text-4xl md:text-6xl font-bold text-orange-500 hover:text-orange-400 hover:scale-105 transition-all duration-300"
        >
          Contact
        </a>
      </nav>
    </div>

    {/* PAGE CONTENT */}
    <slot />

    {/* FOOTER */}
    <Footer />

    {/* NAVIGATION SCRIPT */}
    <script>
      const menuToggle = document.getElementById('menu-toggle');
      const menuOverlay = document.getElementById('menu-overlay');
      const line1 = document.getElementById('line1');
      const line2 = document.getElementById('line2');
      const line3 = document.getElementById('line3');
      const menuLinks = document.querySelectorAll('.menu-link');

      let isMenuOpen = false;

      menuToggle?.addEventListener('click', () => {
        isMenuOpen = !isMenuOpen;

        if (isMenuOpen) {
          // Open Menu
          menuOverlay?.classList.remove('translate-x-full');
          menuOverlay?.classList.add('translate-x-0');
          document.body.style.overflow = 'hidden'; // Stop scrolling

          // Animate Hamburger to X
          line1?.classList.add('rotate-45', 'translate-y-2.5');
          line2?.classList.add('opacity-0', 'translate-x-4');
          line3?.classList.add('-rotate-45', '-translate-y-2.5');

        } else {
          // Close Menu
          menuOverlay?.classList.add('translate-x-full');
          menuOverlay?.classList.remove('translate-x-0');
          document.body.style.overflow = 'auto'; // Resume scrolling

          // Animate X back to Hamburger
          line1?.classList.remove('rotate-45', 'translate-y-2.5');
          line2?.classList.remove('opacity-0', 'translate-x-4');
          line3?.classList.remove('-rotate-45', '-translate-y-2.5');
        }
      });

      // Close menu when a link is clicked
      menuLinks.forEach(link => {
        link.addEventListener('click', () => {
          if(isMenuOpen) menuToggle?.click();
        });
      });
    </script>

  </body>
</html>

<style is:global>
  /* Base font settings if you want to enforce specific fonts globally */
  :root {
    --font-body: 'Inter', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
  }
  
  html {
    font-family: var(--font-body);
  }
  
  code, pre, .font-mono {
    font-family: var(--font-mono);
  }
</style>