---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Me | Naim Afgan">
  <main class="min-h-screen bg-black text-white relative">

    {/* GLOBAL CONTENT CONTAINER */}
    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 pt-28">

      {/* =====================================================
          1. GLAVNI NASLOV (HERO)
      ===================================================== */}
      <div class="mb-24 md:mb-32 animate-fade-in text-center md:text-left">
        <h1 class="text-4xl md:text-5xl lg:text-7xl font-extrabold leading-tight max-w-5xl">
          Harnessing AI for 
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-red-600">
            growth & innovation
          </span>, 
          while keeping your culture authentic.
        </h1>
      </div>


      {/* =====================================================
          2. WHAT I DO
      ===================================================== */}
      <div class="mb-28 md:mb-32 animate-fade-in" style="animation-delay: 0.1s">

        {/* Naslov Sekcije */}
        <div class="flex items-center gap-3 mb-12 md:mb-16 border-b border-white/10 pb-3">
          <span class="w-8 h-[1px] bg-orange-500"></span>
          <h2 class="text-orange-500 font-mono text-sm tracking-widest uppercase font-bold">
            What I Do
          </h2>
        </div>

        {/* Grid Kartice */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

          {/* Card 1 */}
          <div class="group relative p-8 rounded-2xl bg-gradient-to-b from-neutral-900 to-black 
                      border border-white/10 hover:border-orange-500/50 transition-all duration-500 
                      hover:shadow-[0_0_40px_-10px_rgba(249,115,22,0.15)] hover:-translate-y-1">

            <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r 
                        from-transparent via-white/20 to-transparent opacity-50"></div>

            <div class="flex flex-col gap-6 h-full">
              <div class="text-orange-500 group-hover:scale-110 transition-transform duration-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" 
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
              </div>

              <div>
                <strong class="text-white text-xl block mb-3 group-hover:text-orange-400 transition-colors">
                  People First
                </strong>
                <p class="text-neutral-400 text-sm leading-relaxed">
                  I place people at the center. My mission is guiding structured AI adoption—from abstract strategy to measurable results.
                </p>
              </div>
            </div>
          </div>

          {/* Card 2 */}
          <div class="group relative p-8 rounded-2xl bg-gradient-to-b from-neutral-900 to-black 
                      border border-white/10 hover:border-orange-500/50 transition-all duration-500 
                      hover:shadow-[0_0_40px_-10px_rgba(249,115,22,0.15)] hover:-translate-y-1">

            <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r 
                        from-transparent via-white/20 to-transparent opacity-50"></div>

            <div class="flex flex-col gap-6 h-full">
              <div class="text-orange-500 group-hover:scale-110 transition-transform duration-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" 
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="2" x2="22" y1="12" y2="12"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
              </div>

              <div>
                <strong class="text-white text-xl block mb-3 group-hover:text-orange-400 transition-colors">
                  Purpose Driven
                </strong>
                <p class="text-neutral-400 text-sm leading-relaxed">
                  True progress happens when teams understand the <em>purpose</em>. I ensure belief in the process, not just the software.
                </p>
              </div>
            </div>
          </div>

          {/* Card 3 */}
          <div class="group relative p-8 rounded-2xl bg-gradient-to-b from-neutral-900 to-black 
                      border border-white/10 hover:border-orange-500/50 transition-all duration-500 
                      hover:shadow-[0_0_40px_-10px_rgba(249,115,22,0.15)] hover:-translate-y-1">

            <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r 
                        from-transparent via-white/20 to-transparent opacity-50"></div>

            <div class="flex flex-col gap-6 h-full">
              <div class="text-orange-500 group-hover:scale-110 transition-transform duration-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" 
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              </div>

              <div>
                <strong class="text-white text-xl block mb-3 group-hover:text-orange-400 transition-colors">
                  Preserving DNA
                </strong>
                <p class="text-neutral-400 text-sm leading-relaxed">
                  Navigating transformation while preserving the core DNA and values that make your organization unique and authentic.
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>


      {/* =====================================================
          3. HOW I WORK
      ===================================================== */}
      <div class="mb-28 md:mb-32 animate-fade-in" style="animation-delay: 0.2s">

        <div class="flex items-center gap-3 mb-12 md:mb-16 border-b border-white/10 pb-3">
          <span class="w-8 h-[1px] bg-orange-500"></span>
          <h2 class="text-orange-500 font-mono text-sm tracking-widest uppercase font-bold">
            How I Work
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

          {/* CARD 01 */}
          <div class="group relative p-8 rounded-2xl bg-gradient-to-b from-neutral-900 to-black 
                      border border-white/10 hover:border-orange-500/50 transition-all duration-500 
                      hover:-translate-y-1">

            <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/20 to-transparent opacity-50"></div>

            <div class="h-12 w-12 bg-orange-900/10 rounded-xl border border-orange-500/20 flex items-center justify-center
                        text-orange-500 mb-6 font-mono font-bold group-hover:scale-110 transition-transform duration-500">
              01
            </div>

            <h3 class="text-xl font-bold text-white mb-4 group-hover:text-orange-400 transition-colors">
              Agile Spirit
            </h3>

            <p class="text-neutral-400 leading-relaxed text-sm">
              I work with an Agile mindset, using a clear, iterative process that gives teams structure, focus, and the space to improve continuously.
            </p>
          </div>

          {/* CARD 02 */}
          <div class="group relative p-8 rounded-2xl bg-gradient-to-b from-neutral-900 to-black 
                      border border-white/10 hover:border-orange-500/50 transition-all duration-500 
                      hover:-translate-y-1">

            <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/20 to-transparent opacity-50"></div>

            <div class="h-12 w-12 bg-orange-900/10 rounded-xl border border-orange-500/20 flex items-center justify-center
                        text-orange-500 mb-6 font-mono font-bold group-hover:scale-110 transition-transform duration-500">
              02
            </div>

            <h3 class="text-xl font-bold text-white mb-4 group-hover:text-orange-400 transition-colors">
              Focus on Progress
            </h3>

            <p class="text-neutral-400 leading-relaxed text-sm">
              I turn complex challenges into small, achievable steps. This approach delivers visible progress while preventing paralysis by analysis.
            </p>
          </div>

          {/* CARD 03 */}
          <div class="group relative p-8 rounded-2xl bg-gradient-to-b from-neutral-900 to-black 
                      border border-white/10 hover:border-orange-500/50 transition-all duration-500 
                      hover:-translate-y-1">

            <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r 
                        from-transparent via-white/20 to-transparent opacity-50"></div>

            <div class="h-12 w-12 bg-orange-900/10 rounded-xl border border-orange-500/20 flex items-center justify-center
                        text-orange-500 mb-6 font-mono font-bold group-hover:scale-110 transition-transform duration-500">
              03
            </div>

            <h3 class="text-xl font-bold text-white mb-4 group-hover:text-orange-400 transition-colors">
              Culture of Trust
            </h3>

            <p class="text-neutral-400 leading-relaxed text-sm">
              I nurture a culture of collaboration. True transformation is only possible when people feel safe to explore new ideas and trust the leadership.
            </p>
          </div>

        </div>
      </div>

    </div>


    {/* =====================================================
        4. FAST FACTS — MOBILE & DESKTOP PERFECT
    ===================================================== */}
    <section class="relative z-10 py-20 bg-neutral-950 border-t border-neutral-900">
      <div 
        class="
          max-w-7xl mx-auto px-6 md:px-12 
          flex flex-col md:flex-row 
          items-center md:items-start 
          justify-between 
          gap-12
          text-center md:text-left
        "
      >

        {/* ITEM 1 */}
        <div>
          <span class="block text-4xl md:text-5xl font-bold text-white mb-1">20+</span>
          <span class="text-neutral-500 uppercase text-[11px] md:text-xs tracking-widest">
            Years Experience
          </span>
        </div>
        <div class="w-full h-px bg-neutral-800 md:hidden"></div>

        {/* ITEM 2 */}
        <div>
          <span class="block text-4xl md:text-5xl font-bold text-white mb-1">Fortune 500</span>
          <span class="text-neutral-500 uppercase text-[11px] md:text-xs tracking-widest">
            Client Portfolio
          </span>
        </div>
        <div class="w-full h-px bg-neutral-800 md:hidden"></div>

        {/* ITEM 3 */}
        <div>
          <span class="block text-4xl md:text-5xl font-bold text-white mb-1">4</span>
          <span class="text-neutral-500 uppercase text-[11px] md:text-xs tracking-widest">
            Key Industries
          </span>
        </div>
        <div class="w-full h-px bg-neutral-800 md:hidden"></div>

        {/* ITEM 4 */}
        <div>
          <span class="block text-4xl md:text-5xl font-bold text-white mb-1">∞</span>
          <span class="text-neutral-500 uppercase text-[11px] md:text-xs tracking-widest">
            Possibilities
          </span>
        </div>

      </div>
    </section>

  </main>
</Layout>

<style>
  .animate-fade-in {
    opacity: 0;
    animation: fadeIn 0.8s ease-out forwards;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
